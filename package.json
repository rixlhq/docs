{
  "name": "rixl-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "knip": "knip --no-progress",
    "lint:suppressions": "! grep -rnE '(eslint|oxlint)-disable' src plugins scripts --include='*.ts' --include='*.tsx' --exclude=routeTree.gen.ts | grep -v ' -- '",
    "test:actions": "for t in .github/actions/cloudflare/test/*.test.sh; do bash \"$t\" || exit 1; done",
    "test:mutation": "stryker run",
    "generate:icons": "vpx plugins/vite-plugin-extract-icons.ts",
    "generate:paraglide": "paraglide-js compile --project project.inlang --outdir ./src/paraglide",
    "postinstall": "vpr generate:paraglide && vpr generate:icons",
    "prepare": "[ -n \"$CI\" ] || lefthook install --reset-hooks-path",
    "machine-translate": "inlang machine translate --project project.inlang"
  },
  "dependencies": {
    "@fumadocs/json-schema": "^0.3.5",
    "@rixl/media-react": "^1.2.0",
    "@sentry/react": "^11.12.0",
    "@takumi-rs/image-response": "^2.20.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "@tanstack/start-static-server-functions": "^1.167.44",
    "class-variance-authority": "^0.7.1",
    "cn": "0.5.2",
    "fumadocs-core": "^16.18.4",
    "fumadocs-mdx": "^15.5.3",
    "fumadocs-openapi": "^12.6.0",
    "fumadocs-ui": "^16.18.4",
    "lucide-react": "^1.72.0",
    "lucide-static": "^1.72.0",
    "next-themes": "^0.4.6",
    "openapi-sampler": "^1.7.10",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zbsearch": "^4.0.3"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.17.0",
    "@inlang/cli": "^3.6.0",
    "@inlang/paraglide-js": "^3.2.2",
    "@sentry/vite-plugin": "11.12.0",
    "@stryker-mutator/api": "^10.1.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/bun": "^1.4.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "^4.14.0",
    "fast-check": "^4.10.2",
    "knip": "^6.45.1",
    "lefthook": "^2.2.2",
    "next-validate-link": "^1.6.7",
    "oxc-transform-react": "^0.158.0",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.6.0",
    "vitest-browser-react": "2.3.0",
    "wrangler": "^4.160.0"
  },
  "overrides": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "bun@1.4.4"
}
