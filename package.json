{
  "name": "rixl-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp preview",
    "knip": "knip --no-progress",
    "lint:suppressions": "! grep -rnE '(eslint|oxlint)-disable' src plugins scripts --include='*.ts' --include='*.tsx' --exclude=routeTree.gen.ts | grep -v ' -- '",
    "test:actions": "for t in .github/actions/cloudflare/test/*.test.sh; do bash \"$t\" || exit 1; done",
    "test:mutation": "stryker run",
    "generate:icons": "vpx plugins/vite-plugin-extract-icons.ts",
    "generate:paraglide": "paraglide-js compile --project project.inlang --outdir ./src/paraglide",
    "postinstall": "vpr generate:paraglide && vpr generate:icons",
    "prepare": "[ -n \"$CI\" ] || lefthook install --reset-hooks-path",
    "machine-translate": "inlang machine translate --project project.inlang"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fumadocs/json-schema": "^0.3.6",
    "@rixl/media-react": "^1.3.0",
    "@rixl/ui": "0.4.0",
    "@sentry/react": "^11.17.0",
    "@takumi-rs/image-response": "^2.22.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.7",
    "@tanstack/start-static-server-functions": "^1.167.44",
    "class-variance-authority": "^0.7.1",
    "cn": "0.5.2",
    "fumadocs-core": "^16.19.7",
    "fumadocs-mdx": "^15.6.4",
    "fumadocs-openapi": "^12.6.7",
    "fumadocs-ui": "^16.19.7",
    "lucide-react": "^1.79.0",
    "lucide-static": "^1.79.0",
    "next-themes": "^0.4.6",
    "openapi-sampler": "^1.7.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zbsearch": "^4.0.4"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.2.0",
    "@inlang/cli": "^3.7.0",
    "@inlang/paraglide-js": "^3.2.2",
    "@sentry/vite-plugin": "11.17.0",
    "@stryker-mutator/api": "^10.1.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/bun": "^1.4.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "5.1.1",
    "@vitest/coverage-v8": "5.1.1",
    "axe-core": "^4.14.1",
    "fast-check": "^4.11.0",
    "knip": "^6.48.0",
    "lefthook": "^2.2.2",
    "next-validate-link": "^1.6.7",
    "oxc-transform-react": "^0.158.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001",
    "vite-plus": "1.8.0",
    "vitest-browser-react": "2.3.0",
    "wrangler": "^4.168.0"
  },
  "overrides": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "bun@1.4.4"
}
