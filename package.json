{
  "name": "rixl-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "start": "vp preview",
    "serve": "vpx serve@latest --no-port-switching dist/client -l tcp://127.0.0.1:4173",
    "serve:spa": "vpx serve@latest --no-port-switching -s dist/client -l tcp://127.0.0.1:4173",
    "generate:icons": "vpx plugins/vite-plugin-extract-icons.ts",
    "generate:fumadocs": "fumadocs-mdx",
    "generate:paraglide": "paraglide-js compile --project project.inlang --outdir ./src/paraglide",
    "postinstall": "vpr generate:fumadocs && vpr generate:paraglide && vpr generate:icons",
    "prepare": "[ -n \"$CI\" ] || lefthook install --reset-hooks-path",
    "machine-translate": "inlang machine translate --project project.inlang"
  },
  "dependencies": {
    "@radix-ui/react-presence": "^1.1.11",
    "@rixl/media-react": "^0.10.1",
    "@takumi-rs/image-response": "^2.19.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/start-static-server-functions": "^1.167.44",
    "class-variance-authority": "^0.7.1",
    "cn": "0.5.2",
    "fumadocs-core": "^16.17.10",
    "fumadocs-mdx": "^15.4.10",
    "fumadocs-openapi": "^11.4.3",
    "fumadocs-ui": "^16.17.10",
    "lucide-react": "^1.68.0",
    "lucide-static": "^1.68.0",
    "openapi-sampler": "^1.7.10",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "yaml": "^2.9.1",
    "zbsearch": "^4.0.2"
  },
  "devDependencies": {
    "@inlang/cli": "^3.6.0",
    "@inlang/paraglide-js": "^3.1.0",
    "@tailwindcss/postcss": "^4.3.4",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/devtools-vite": "^0.8.6",
    "@types/bun": "^1.4.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "lefthook": "^2.2.2",
    "next-validate-link": "^1.6.7",
    "oxc-transform-react": "^0.157.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0",
    "wrangler": "^4.157.0"
  },
  "overrides": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "bun@1.4.3"
}
