{
  "name": "rixl-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "vp run clean && vp run lint && vp run lint:links && vp build",
    "ci:build": "vp run build",
    "cf:upload": "wrangler versions upload --tag \"$(git rev-parse --short=12 HEAD)\" --message \"main $(git rev-parse --short=12 HEAD)\"",
    "clean": "rm -rf dist",
    "dev": "vp dev",
    "start": "vp preview",
    "serve": "vp dlx serve@latest --no-port-switching dist/client -l tcp://127.0.0.1:4173",
    "serve:spa": "vp dlx serve@latest --no-port-switching -s dist/client -l tcp://127.0.0.1:4173",
    "lint": "vp lint --max-warnings=0 && fumadocs-mdx",
    "lint:links": "node ./scripts/lint.ts",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "generate:icons": "node plugins/vite-plugin-extract-icons.ts",
    "postinstall": "fumadocs-mdx && vp run generate:icons && paraglide-js compile --project project.inlang --outdir ./src/paraglide",
    "prepare": "vp config || true",
    "machine-translate": "inlang machine translate --project project.inlang"
  },
  "dependencies": {
    "@radix-ui/react-presence": "^1.1.11",
    "@rixl/media-react": "^0.10.0",
    "@takumi-rs/image-response": "^2.16.2",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.169.1",
    "@tanstack/start-static-server-functions": "^1.167.42",
    "class-variance-authority": "^0.7.1",
    "cn": "0.4.0",
    "fumadocs-core": "^16.17.3",
    "fumadocs-mdx": "^15.4.7",
    "fumadocs-openapi": "^11.4.3",
    "fumadocs-ui": "^16.17.3",
    "lucide-react": "^1.57.0",
    "lucide-static": "^1.57.0",
    "openapi-sampler": "^1.7.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.5.0",
    "yaml": "^2.9.1",
    "zbsearch": "^4.0.1"
  },
  "devDependencies": {
    "@inlang/cli": "^3.4.4",
    "@inlang/paraglide-js": "^2.27.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@types/bun": "^1.4.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "next-validate-link": "^1.6.7",
    "oxc-transform-react": "^0.154.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0",
    "wrangler": "^4.151.0"
  },
  "overrides": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "download"
    }
  },
  "packageManager": "bun@1.4.3"
}
