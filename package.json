{
  "name": "rixl-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "bun run clean && bun lint && vite build",
    "clean": "rm -rf dist",
    "dev": "vite dev",
    "start": "vite preview",
    "serve": "bunx serve@latest --no-port-switching dist/client -l tcp://127.0.0.1:4173",
    "serve:spa": "bunx serve@latest --no-port-switching -s dist/client -l tcp://127.0.0.1:4173",
    "lint": "oxlint --max-warnings=0 && fumadocs-mdx",
    "lint:links": "bun ./scripts/lint.ts",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "postinstall": "fumadocs-mdx",
    "machine-translate": "inlang machine translate --project project.inlang"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@radix-ui/react-presence": "^1.1.10",
    "@nanostores/react": "^1.1.0",
    "@rixl/media-react": "^0.5.0",
    "nanostores": "^1.2.0",
    "@takumi-rs/image-response": "^2.5.9",
    "@tanstack/react-router": "^1.170.19",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-start": "^1.168.36",
    "@tanstack/start-static-server-functions": "^1.167.20",
    "class-variance-authority": "^0.7.1",
    "fumadocs-core": "^16.14.0",
    "fumadocs-mdx": "^15.2.2",
    "fumadocs-openapi": "^11.2.3",
    "fumadocs-ui": "^16.14.0",
    "lucide-react": "^1.28.0",
    "lucide-static": "^1.28.0",
    "openapi-sampler": "^1.7.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.2",
    "cnfast": "^0.1.0"
  },
  "devDependencies": {
    "@inlang/cli": "^3.3.0",
    "@inlang/paraglide-js": "^2.23.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.3",
    "@types/bun": "^1.3.14",
    "@types/mdx": "^2.0.14",
    "@types/node": "26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "next-validate-link": "^1.6.7",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.119.0"
  },
  "overrides": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.14",
      "onFail": "download"
    }
  }
}
