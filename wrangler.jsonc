{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rixl-docs",
  "compatibility_date": "2026-03-01",
  "preview_urls": true,
  "previews": {},
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "docs.rixl.com",
      "custom_domain": true
    }
  ]
}
